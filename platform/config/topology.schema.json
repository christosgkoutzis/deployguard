{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployguard.dev/schemas/topology.schema.json",
  "title": "DeployGuard topology v1",
  "type": "object",
  "properties": {
    "apiVersion": {
      "enum": [
        "deployguard/v1"
      ]
    },
    "name": {
      "$ref": "#/$defs/entityName"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/entityName"
          },
          "depends_on": {
            "$ref": "#/$defs/entityNames"
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "chart": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "set": {
            "$ref": "#/$defs/assignments"
          },
          "values": {
            "type": "object"
          },
          "values_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "repo",
              "chart",
              "version"
            ]
          }
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/entityName"
          },
          "depends_on": {
            "$ref": "#/$defs/entityNames"
          },
          "env": {
            "$ref": "#/$defs/assignments"
          },
          "secret_env": {
            "$ref": "#/$defs/secretEnvironment"
          },
          "env_from": {
            "$ref": "#/$defs/entityNames"
          },
          "type": {
            "enum": [
              "webservice",
              "worker",
              "test"
            ]
          },
          "build_path": {
            "type": "string",
            "minLength": 1
          },
          "env_file": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "health_endpoint": {
            "type": "string",
            "pattern": "^/"
          },
          "resources": {
            "$ref": "#/$defs/resources"
          },
          "external_secret": {
            "type": "object",
            "properties": {
              "store": {
                "$ref": "#/$defs/entityName"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "store",
              "path"
            ],
            "additionalProperties": false
          },
          "init_command": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "mocks": {
      "$ref": "#/$defs/entityNames"
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/entityName"
          },
          "depends_on": {
            "$ref": "#/$defs/entityNames"
          },
          "env": {
            "$ref": "#/$defs/assignments"
          },
          "secret_env": {
            "$ref": "#/$defs/secretEnvironment"
          },
          "env_from": {
            "$ref": "#/$defs/entityNames"
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "build_path": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "files": {
            "type": "string",
            "minLength": 1
          },
          "resources": {
            "$ref": "#/$defs/resources"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "command"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "image"
            ]
          },
          {
            "required": [
              "build_path"
            ]
          }
        ]
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/entityName"
          },
          "values": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "required": [
          "name",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "secret_stores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/entityName"
          },
          "server": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "token_secret": {
            "$ref": "#/$defs/secretReference"
          },
          "depends_on": {
            "$ref": "#/$defs/entityNames"
          }
        },
        "required": [
          "name",
          "server",
          "token_secret"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [],
  "additionalProperties": false,
  "$defs": {
    "entityName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "maxLength": 40
    },
    "entityNames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityName"
      },
      "uniqueItems": true
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "secretReference": {
      "type": "object",
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/entityName"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "secretEnvironment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/secretReference"
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceQuantities"
        },
        "limits": {
          "$ref": "#/$defs/resourceQuantities"
        }
      },
      "additionalProperties": false
    },
    "resourceQuantities": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": [
            "string",
            "number"
          ]
        },
        "ephemeral-storage": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
