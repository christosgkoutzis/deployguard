# Install creates .env from this example. Demo credentials are for local use only.
CLUSTER_NAME=control-plane-cluster
NAMESPACE=deployguard
ARGO_APP_NAMESPACE=argocd
CLUSTER_DOMAIN=127.0.0.1.nip.io
API_PORT=6443
INGRESS_PORT=8080
SOURCE_PORT=8081
TIMEOUT_SECONDS=600

# Demo dependency credentials; submitted as Kubernetes Secrets, never Git values.
VAULT_ROOT_TOKEN=your-secure-token
# S3 credentials for object storage. RabbitMQ uses the admin account.
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=your-secure-password
POSTGRES_PASSWORD=your-secure-password
RABBITMQ_PASSWORD=your-rabbitmq-password
REDIS_PASSWORD=secure-redis-pass
ELASTIC_PASSWORD=secure-elastic-pass
