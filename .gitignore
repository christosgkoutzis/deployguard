# Local credentials and all generated tooling/runtime content
.env
.local/

# Additional local environments and caches
.venv/
.tools/
.deployguard/
.pytest_cache/
.sync-env.env

# Python bytecode (also covered when redirected to .local/cache)
__pycache__/
*.py[cod]

# Native Helm subcharts vendored locally
platform/charts/*/charts/
platform/dependencies/*/charts/
